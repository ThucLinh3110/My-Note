<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F3F3F3">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:orientation="vertical"
            android:background="#4A86F7"
            android:gravity="center_horizontal"
            android:paddingTop="26dp">


            <LinearLayout
                android:layout_width="58dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_header_icon"
                android:gravity="center">


                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_lock_lock"
                    android:tint="#FFFFFF" />
            </LinearLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đổi mật khẩu mới"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="21sp"
                android:layout_marginTop="12dp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tối thiểu 8 ký tự, bao gồm"
                android:textColor="#EEF4FF"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="chữ hoa, chữ số và ký tự đặc biệt"
                android:textColor="#EEF4FF"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>


        <!-- Step -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">


            <View
                android:layout_width="12dp"
                android:layout_height="5dp"
                android:background="@drawable/bg_step_inactive" />


            <View
                android:layout_width="12dp"
                android:layout_height="5dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_step_inactive" />


            <View
                android:layout_width="24dp"
                android:layout_height="5dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_step_active" />
        </LinearLayout>


        <!-- Nội dung -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="24dp">


            <!-- Label mật khẩu mới -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhập mật khẩu"
                android:textColor="#3F7EF8"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_login_input"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">


                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_lock_lock"
                    android:tint="#5A8DF7" />


                <EditText
                    android:id="@+id/edtNewPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Nhập mật khẩu"
                    android:inputType="textPassword"
                    android:textSize="13sp"
                    android:textColor="#333333"
                    android:textColorHint="#9A9A9A"
                    android:paddingStart="8dp" />


                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_menu_view"
                    android:tint="#9A9A9A" />
            </LinearLayout>


            <!-- Label xác nhận -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xác nhận mật khẩu"
                android:textColor="#3F7EF8"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_login_input"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">


                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/checkbox_on_background"
                    android:tint="#5A8DF7" />


                <EditText
                    android:id="@+id/edtConfirmNewPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Nhập mật khẩu"
                    android:inputType="textPassword"
                    android:textSize="13sp"
                    android:textColor="#333333"
                    android:textColorHint="#9A9A9A"
                    android:paddingStart="8dp" />


                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_menu_view"
                    android:tint="#9A9A9A" />
            </LinearLayout>


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnResetPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_login_button"
                android:backgroundTint="@null"
                android:text="Đặt lại mật khẩu"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />


        </LinearLayout>


    </LinearLayout>
</ScrollView>

