<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F7">

    <RelativeLayout
        android:id="@+id/headerDetail"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#F2F2F7">

        <ImageView
            android:id="@+id/btnBackDetail"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="#007AFF" />

        <TextView
            android:id="@+id/tvFolderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Tên thư mục"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- FILTER nằm bên trái -->
        <ImageView
            android:id="@+id/btnFilterDetail"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btnSortDetail"
            android:padding="8dp"
            android:src="@drawable/ic_filter"
            app:tint="#007AFF" />

        <ImageView
            android:id="@+id/btnSortDetail"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:padding="8dp"
            android:src="@drawable/ic_sort"
            app:tint="#007AFF" />
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotesInFolder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerDetail"
        android:clipToPadding="false"
        android:padding="12dp"
        android:paddingBottom="100dp"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="20dp"
        android:src="@drawable/ic_menu_edit"
        app:backgroundTint="#FFFFFF"
        app:tint="#007AFF"
        app:elevation="4dp"
        app:borderWidth="0dp"/>
</RelativeLayout>