<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:id="@+id/layoutTextArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@id/imgSearchThumb"
        android:layout_alignParentStart="true"
        android:layout_marginEnd="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSearchNoteTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trinh"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSearchNoteDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="27/2/2026 13:37"
            android:textColor="#8E8E93"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/layoutFolderRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgSearchFolderIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_folder" />

            <TextView
                android:id="@+id/tvSearchNoteFolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Tất cả ghi chú"
                android:textColor="#8E8E93"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/imgSearchThumb"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_gallery"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/imgSearchArrow"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:src="@drawable/ic_chevron_right"
        android:tint="#C7C7CC" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="16dp"
        android:background="#E5E5EA" />
</RelativeLayout>